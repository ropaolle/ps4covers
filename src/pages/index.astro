---
import Layout from "../layouts/Layout.astro";
import { getImage } from "astro:assets";
import GameView, { type GameItem } from "../components/GameView";
import "../styles/global.css";
import games from "../data/games.json";
import manifest from "../data/manifest.json";

// Import all images from src/assets/gallery
const imageModules = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/gallery/**/*.{jpeg,jpg,png,gif,webp,JPEG,JPG,PNG,WEBP}",
  { eager: true },
);

// Optimize each image with getImage() at build time
const images = await Promise.all(
  Object.entries(imageModules).map(async ([path, mod]) => {
    const optimized = await getImage({ src: mod.default, width: 600, height: 600, format: "webp" });
    const filename = path.split("/").pop() ?? "";
    const id = filename.slice(0, -4);

    return { src: optimized.src, filename, id };
  }),
);

// Merge images and games
const imageMap = new Map(images.map((image) => [image.id, image]));

const gameList: GameItem[] = games.map((game) => {
  const match = imageMap.get(game.id) || imageMap.get("PLACEHOLDER") || { src: "", filename: "", id: "" };
  const pkgInfo = manifest.Entries.find((entry) => entry.TitleId === game.id && entry.Category === "Game");

  return {
    ...game,
    owner: game.owner ?? false,
    completed: game.completed ?? false,
    ignore: game.ignore ?? false,
    working: game.working ?? false,
    comment: game.comment ?? "",
    dlcs: game.dlcs ?? "",
    ...match,
    latestUpdate: pkgInfo?.LatestUpdate ?? "",
    altName: pkgInfo?.Title ?? "",
    region: pkgInfo?.Region ?? "",
  };
});

console.log("gameList", gameList[0]);
const genreSet = new Set(games.map((game) => game.genre.split(",").map((g) => g.trim())).flat());

// const genres = games.map((game) => game.genre.split(",")).flat().map((str) => str.trim()).reduce<Record<string, number>>((acc, item) => {
//   acc[item] = (acc[item] || 0) + 1;
//   return acc;
// }, {});

// const sortedGenres = Object.fromEntries(
//   Object.entries(genres).sort(([keyA], [keyB]) => keyA.localeCompare(keyB))
// );

// console.log(sortedGenres);

---

<Layout>
  <div class="bg-gray-50 text-gray-900 min-h-screen">
    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
      <h1 class="text-3xl font-bold tracking-tight mb-0">PS4 Games</h1>
      <!-- Hydrate React component on the client -->
      <GameView client:load games={gameList} genres={Array.from(genreSet)} />
      <!-- <GameView client:load games={gameList} genres={genres} /> -->
    </main>
  </div>
</Layout>
