---
// import Welcome from "../components/Welcome.astro";
// import Layout from "../layouts/Layout.astro";
import { getImage } from "astro:assets";
import ImageGallery, { type GalleryImage } from "../components/ImageGallery";
import "../styles/global.css"; // Ensure Tailwind CSS is imported
import games from "../data/games.json";
import manifest from "../data/manifest.json";

// Welcome to Astro! Wondering what to do next? Check out the Astro documentation at https://docs.astro.build
// Don't want to use any of this? Delete everything in this file, the `assets`, `components`, and `layouts` directories, and start fresh.

// Import all images from src/assets/gallery
const imageModules = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/gallery/**/*.{jpeg,jpg,png,gif,webp,JPEG,JPG,PNG,WEBP}",
  { eager: true },
);

// Optimize each image with getImage() at build time
const images: GalleryImage[] = await Promise.all(
  Object.entries(imageModules).map(async ([path, mod]) => {
    const optimized = await getImage({
      src: mod.default,
      width: 600,
      height: 600,
      format: "webp",
    });

    // Extract clean filename (e.g., "/src/assets/gallery/CUSA00010.jpg" -> "CUSA00010.jpg")
    const filename = path.split("/").pop() ?? "";
    const id = filename.slice(0, -4);

    // if (optimized.attributes.width < 1024) {
    //   console.warn(`WARNING: Image smaller then 1024px ${filename} -> ${optimized.attributes.width}px`);
    // }

    return {
      src: optimized.src,
      filename,
      id
    };
  }),
);


// Merge images and games
const imageMap = new Map(images.map((image) => [image.id, image]));
const gameList = games.map((game) => {
  const match = imageMap.get(game.id);
  const pkgInfo = manifest.Entries.find((entry) => entry.TitleId === game.id && entry.Category === "Game");  
  
  if (!match) {
    console.warn(`WARNING: No matching image found for game ID: ${game.id}`);
  }

  return {
    ...game,
    pkgInfo,
    ...(match || { src: null, filename: "" }), // Använder standardvärden om match saknas
  };
});

console.log("INFO: Found images:", images.length);

---

<body class="bg-gray-50 text-gray-900 min-h-screen">
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <h1 class="text-3xl font-bold tracking-tight mb-8">Image Gallery</h1>

    <!-- Hydrate React component on the client -->
    <ImageGallery client:load images={gameList} />
  </main>
</body>


